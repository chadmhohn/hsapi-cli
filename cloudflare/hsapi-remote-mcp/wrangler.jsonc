{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hsapi-remote-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,

  // Copy this file to the gitignored wrangler.operator.jsonc before deploying.
  // Replace every placeholder binding and URL there; never commit secrets.
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "MCP_ALLOWED_ORIGINS": "http://localhost:8787",
    "MCP_ACCESS_TOKEN_TTL_SECONDS": "900",
    "REMOTE_WRITES_ENABLED": "true",
    "HUBSPOT_REQUIRE_USER_LEVEL": "true",
    "HUBSPOT_BROKER_URL": "https://hsapi-remote-oauth.REPLACE.example",
    "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
    "HUBSPOT_REQUIRED_SCOPES": "oauth",
    "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.tickets.read crm.objects.line_items.read crm.objects.products.read crm.objects.quotes.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.notes.read crm.objects.calls.read crm.objects.meetings.read crm.objects.emails.read crm.objects.contracts.read crm.objects.marketing_events.read mcp.users.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.write crm.objects.line_items.write crm.objects.products.write crm.objects.tasks.write crm.objects.notes.write crm.objects.calls.write crm.objects.meetings.write crm.objects.emails.write crm.objects.marketing_events.write",
    "HUBSPOT_APP_SCOPE_CEILING": "oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write"
  },

  "secrets": {
    "required": ["STATE_ENCRYPTION_KEY"]
  },

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CONFIRMATION_LEDGER",
        "class_name": "ConfirmationLedger"
      },
      {
        "name": "AUTHORIZATION_STATE",
        "class_name": "AuthorizationState"
      }
    ]
  },

  "exports": {
    "ConfirmationLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AuthorizationState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "1901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "REMOTE_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],

  "triggers": {
    "crons": ["17 * * * *"]
  },

  // Broker completion callbacks carry one-time completion grants. Keep
  // explicit structured logs, but suppress automatic full-URL invocation logs.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },

  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_ORIGIN": "https://hsapi-remote-mcp-staging.REPLACE.workers.dev",
        "MCP_ALLOWED_ORIGINS": "https://hsapi-remote-mcp-staging.REPLACE.workers.dev",
        "MCP_ACCESS_TOKEN_TTL_SECONDS": "900",
        "REMOTE_WRITES_ENABLED": "true",
        "HUBSPOT_REQUIRE_USER_LEVEL": "true",
        "HUBSPOT_BROKER_URL": "https://hsapi-remote-oauth.REPLACE.example",
        "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
        "HUBSPOT_REQUIRED_SCOPES": "oauth",
        "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.tickets.read crm.objects.line_items.read crm.objects.products.read crm.objects.quotes.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.notes.read crm.objects.calls.read crm.objects.meetings.read crm.objects.emails.read crm.objects.contracts.read crm.objects.marketing_events.read mcp.users.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.write crm.objects.line_items.write crm.objects.products.write crm.objects.tasks.write crm.objects.notes.write crm.objects.calls.write crm.objects.meetings.write crm.objects.emails.write crm.objects.marketing_events.write",
        "HUBSPOT_APP_SCOPE_CEILING": "oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "00000000000000000000000000000000"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CONFIRMATION_LEDGER",
            "class_name": "ConfirmationLedger"
          },
          {
            "name": "AUTHORIZATION_STATE",
            "class_name": "AuthorizationState"
          }
        ]
      },
      "secrets": {
        "required": ["STATE_ENCRYPTION_KEY"]
      },
      "ratelimits": [
        {
          "name": "EDGE_RATE_LIMITER",
          "namespace_id": "1902",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "REMOTE_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2102",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 1 }
      }
    },
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "hsapi-mcp.REPLACE.example",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_ORIGIN": "https://hsapi-mcp.REPLACE.example",
        "MCP_ALLOWED_ORIGINS": "https://hsapi-mcp.REPLACE.example",
        "MCP_ACCESS_TOKEN_TTL_SECONDS": "900",
        "REMOTE_WRITES_ENABLED": "true",
        "HUBSPOT_REQUIRE_USER_LEVEL": "true",
        "HUBSPOT_BROKER_URL": "https://hsapi-remote-oauth.REPLACE.example",
        "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
        "HUBSPOT_REQUIRED_SCOPES": "oauth",
        "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.tickets.read crm.objects.line_items.read crm.objects.products.read crm.objects.quotes.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.notes.read crm.objects.calls.read crm.objects.meetings.read crm.objects.emails.read crm.objects.contracts.read crm.objects.marketing_events.read mcp.users.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.write crm.objects.line_items.write crm.objects.products.write crm.objects.tasks.write crm.objects.notes.write crm.objects.calls.write crm.objects.meetings.write crm.objects.emails.write crm.objects.marketing_events.write",
        "HUBSPOT_APP_SCOPE_CEILING": "oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "00000000000000000000000000000000"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CONFIRMATION_LEDGER",
            "class_name": "ConfirmationLedger"
          },
          {
            "name": "AUTHORIZATION_STATE",
            "class_name": "AuthorizationState"
          }
        ]
      },
      "secrets": {
        "required": ["STATE_ENCRYPTION_KEY"]
      },
      "ratelimits": [
        {
          "name": "EDGE_RATE_LIMITER",
          "namespace_id": "1903",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "REMOTE_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2103",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 0.1 }
      }
    }
  }
}
