{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hsapi-remote-oauth-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,

  // Dedicated upstream broker for the remote MCP public app. Copy this file
  // to the gitignored wrangler.remote.operator.jsonc and replace every
  // placeholder. Never reuse the local app client ID, client secret, signing
  // key, callback domain, or Durable Object/rate-limit deployment.
  "vars": {
    "ENVIRONMENT": "local",
    "HSAPI_BROKER_ROLE": "remote",
    "HSAPI_ALLOWED_REMOTE_COMPLETION_REDIRECT_URIS": "https://hsapi-remote-mcp.REPLACE.example/hubspot/callback",
    "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
    "HUBSPOT_REDIRECT_URI": "https://hsapi-remote-oauth.REPLACE.example/v1/oauth/callback",
    "HUBSPOT_REQUIRED_SCOPES": "oauth",
    "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write automation.sequences.read automation.sequences.enrollments.write"
  },

  "secrets": {
    "required": ["HUBSPOT_CLIENT_SECRET", "BROKER_SIGNING_KEY"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_SESSIONS",
        "class_name": "OAuthSession"
      }
    ]
  },

  "exports": {
    "OAuthSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 120, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },

  "env": {
    "staging": {
      "name": "hsapi-remote-oauth-broker-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "HSAPI_BROKER_ROLE": "remote",
        "HSAPI_ALLOWED_REMOTE_COMPLETION_REDIRECT_URIS": "https://hsapi-remote-mcp-staging.REPLACE.workers.dev/hubspot/callback",
        "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
        "HUBSPOT_REDIRECT_URI": "https://hsapi-remote-oauth-broker-staging.REPLACE.workers.dev/v1/oauth/callback",
        "HUBSPOT_REQUIRED_SCOPES": "oauth",
        "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write automation.sequences.read automation.sequences.enrollments.write"
      },
      "secrets": {
        "required": ["HUBSPOT_CLIENT_SECRET", "BROKER_SIGNING_KEY"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OAUTH_SESSIONS",
            "class_name": "OAuthSession"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 1 }
      }
    },
    "production": {
      "name": "hsapi-remote-oauth-broker-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "hsapi-remote-oauth.REPLACE.example",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "HSAPI_BROKER_ROLE": "remote",
        "HSAPI_ALLOWED_REMOTE_COMPLETION_REDIRECT_URIS": "https://hsapi-mcp.REPLACE.example/hubspot/callback",
        "HUBSPOT_CLIENT_ID": "00000000-0000-4000-8000-000000000002",
        "HUBSPOT_REDIRECT_URI": "https://hsapi-remote-oauth.REPLACE.example/v1/oauth/callback",
        "HUBSPOT_REQUIRED_SCOPES": "oauth",
        "HUBSPOT_OPTIONAL_SCOPES": "crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read crm.objects.contacts.write crm.objects.companies.write crm.objects.deals.write crm.objects.tickets.read crm.objects.tickets.write crm.objects.line_items.read crm.objects.line_items.write crm.objects.products.read crm.objects.products.write crm.objects.quotes.read crm.objects.owners.read crm.objects.subscriptions.read crm.objects.carts.read crm.objects.orders.read crm.objects.invoices.read crm.objects.tasks.read crm.objects.tasks.write crm.objects.notes.read crm.objects.notes.write crm.objects.calls.read crm.objects.calls.write crm.objects.meetings.read crm.objects.meetings.write crm.objects.emails.read crm.objects.emails.write crm.objects.contracts.read crm.objects.marketing_events.read crm.schemas.calls.read crm.schemas.emails.read crm.schemas.meetings.read crm.schemas.notes.read crm.schemas.tasks.read crm.lists.read crm.hubsql.execute cpq.quote_templates.read cpq.quotes.read cms.blogs.blog_posts.read cms.pages.landing_pages.read cms.pages.site_pages.read marketing.campaigns.read marketing.campaigns.revenue.full.read marketing.campaigns.revenue.lite.read settings.users.teams.read mcp.users.read cpq.quotes.write crm.objects.marketing_events.write automation.sequences.read automation.sequences.enrollments.write"
      },
      "secrets": {
        "required": ["HUBSPOT_CLIENT_SECRET", "BROKER_SIGNING_KEY"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OAUTH_SESSIONS",
            "class_name": "OAuthSession"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false, "head_sampling_rate": 0.1 }
      }
    }
  }
}
